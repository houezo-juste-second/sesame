{
  "name": "sesame",
  "private": true,
  "version": "0.1.0",
  "description": "Sésame — paiement à la livraison sans cash : séquestre Lightning non-custodial (factures hold).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "dev:web": "npm run dev -w @sesame/web",
    "build": "npm run build -w @sesame/web",
    "start": "tsx apps/server/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "~4.23.15",
    "typescript": "~5.9.3",
    "vitest": "~5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
