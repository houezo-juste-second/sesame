# Copier en .env et compléter. Ne jamais committer le fichier .env.

# Clé maîtresse de chiffrement des secrets au repos (32 octets en hexadécimal).
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESAME_MASTER_KEY=

# Mode wallet : simulation | lnd | nwc
SESAME_WALLET_MODE=simulation

# Mode lnd (regtest local) : rempli automatiquement par infra/scripts/bootstrap.sh
LND_SELLER_REST_URL=https://127.0.0.1:8082
LND_SELLER_MACAROON_PATH=.regtest/seller.macaroon.hex
LND_SELLER_TLS_CERT_PATH=.regtest/seller.tls.cert

# Module IA (optionnel : sans clé, le formulaire manuel reste disponible)
ANTHROPIC_API_KEY=
