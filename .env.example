# Copier en .env et compléter. Ne jamais committer le fichier .env.

# Clé maîtresse de chiffrement des secrets au repos (32 octets en hexadécimal).
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESAME_MASTER_KEY=

# Mode wallet : simulation | lnd | nwc
SESAME_WALLET_MODE=simulation

# Mode lnd (regtest local) : rempli automatiquement par infra/scripts/bootstrap.sh
LND_SELLER_REST_URL=https://127.0.0.1:8082
LND_SELLER_MACAROON_PATH=.regtest/seller.macaroon.hex
LND_SELLER_TLS_CERT_PATH=.regtest/seller.tls.cert

# Module IA — gratuit par défaut (extraction heuristique hors ligne, aucune clé requise).
# Optionnel : tout modèle « OpenAI-compatible » en offre gratuite, par exemple :
#   Groq          SESAME_AI_BASE_URL=https://api.groq.com/openai/v1  SESAME_AI_MODEL=llama-3.3-70b-versatile
#   Google Gemini SESAME_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  SESAME_AI_MODEL=gemini-2.0-flash
#   Ollama local  SESAME_AI_BASE_URL=http://localhost:11434/v1  SESAME_AI_MODEL=llama3.2
SESAME_AI_BASE_URL=
SESAME_AI_API_KEY=
SESAME_AI_MODEL=

# Code PIN de la boutique de démonstration (mode simulation)
SESAME_DEMO_PIN=2026
